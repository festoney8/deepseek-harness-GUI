{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell-windows",
  "description": "Allow the main window to run fixed Node.js and DSH setup commands on Windows",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "node-version",
          "cmd": "node.exe",
          "args": ["-V"],
          "sidecar": false
        },
        {
          "name": "npm-version",
          "cmd": "npm.cmd",
          "args": ["-V"],
          "sidecar": false
        },
        {
          "name": "dsh-version",
          "cmd": "dsh.cmd",
          "args": ["-V"],
          "sidecar": false
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "npm-install-dsh",
          "cmd": "npm.cmd",
          "args": ["install", "-g", "--verbose", "@deepseek-ai/dsh"],
          "sidecar": false
        }
      ]
    }
  ]
}
