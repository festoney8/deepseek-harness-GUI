    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify/json": "^2.2.518",
    "@iconify/types": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
